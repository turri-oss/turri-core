{
  "name": "@turri-dev/core",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turri-oss/turri.git"
  },
  "homepage": "https://github.com/turri-oss/turri#readme",
  "bugs": "https://github.com/turri-oss/turri/issues",
  "description": "turri's core: the harness that builds code from ***plain specifications, with harness-enforced review and conformance gates - its sessions, chats, work loop and agents, without the terminal UI or the command line.",
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": {
      "turri-source": "./src/extension.ts",
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    },
    "./host": {
      "turri-source": "./src/host.ts",
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "turri-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutation": "node scripts/mutation.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@langchain/langgraph": "1.4.15",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.2",
    "liquidjs": "^10.29.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "remark-parse": "^11.0.0",
    "typebox": "^1.3.7",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "genome",
    "stdlib",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
