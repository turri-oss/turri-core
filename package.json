{
  "name": "@turri-dev/core",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turri-oss/turri-core.git"
  },
  "homepage": "https://github.com/turri-oss/turri-core#readme",
  "bugs": "https://github.com/turri-oss/turri-core/issues",
  "description": "turri's core: the harness that builds code from ***plain specifications, with harness-enforced review and conformance gates - its sessions, chats, work loop and agents, without the terminal UI or the command line.",
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": {
      "turri-source": "./src/api/session.ts",
      "types": "./dist/api/session.d.ts",
      "import": "./dist/api/session.js"
    },
    "./plain": {
      "turri-source": "./src/api/plain.ts",
      "types": "./dist/api/plain.d.ts",
      "import": "./dist/api/plain.js"
    },
    "./project": {
      "turri-source": "./src/api/project.ts",
      "types": "./dist/api/project.d.ts",
      "import": "./dist/api/project.js"
    },
    "./models": {
      "turri-source": "./src/api/models.ts",
      "types": "./dist/api/models.d.ts",
      "import": "./dist/api/models.js"
    },
    "./system": {
      "turri-source": "./src/api/system.ts",
      "types": "./dist/api/system.d.ts",
      "import": "./dist/api/system.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "api:report": "npm run build && node scripts/api-report.mjs --update",
    "api:check": "npm run build && node scripts/api-report.mjs",
    "test:package": "npm run build && node scripts/package-contract.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutation": "node scripts/mutation.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@langchain/langgraph": "1.4.15",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.2",
    "liquidjs": "^10.29.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "remark-parse": "^11.0.0",
    "typebox": "^1.3.7",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@microsoft/api-extractor": "7.60.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "genome",
    "stdlib",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
